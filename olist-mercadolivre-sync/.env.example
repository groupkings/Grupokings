# ======================================================================
# Olist / Tiny — API v2 (autenticação por token)
# Gere o token em: Tiny > Configurações > Tokens da API (API v2)
# ======================================================================
TINY_TOKEN=coloque_seu_token_do_tiny_aqui
TINY_BASE_URL=https://api.tiny.com.br/api2

# ======================================================================
# Mercado Livre — API oficial (OAuth2)
# Crie a aplicação em: https://developers.mercadolivre.com.br/devcenter
# Você precisa de: Client ID, Client Secret e um Refresh Token
# (obtido no fluxo OAuth com o code de autorização).
# ======================================================================
ML_CLIENT_ID=seu_app_id
ML_CLIENT_SECRET=seu_client_secret
ML_REFRESH_TOKEN=seu_refresh_token
# Opcional: se já tiver um access token válido, coloque aqui (senão é gerado).
ML_ACCESS_TOKEN=

# Site do Mercado Livre: MLB=Brasil, MLA=Argentina, MLM=México...
ML_SITE_ID=MLB
ML_BASE_URL=https://api.mercadolibre.com

# ======================================================================
# Padrões dos anúncios
# ======================================================================
# gold_special (clássico) ou gold_pro (premium)
ML_LISTING_TYPE_ID=gold_special
ML_CONDITION=new
ML_CURRENCY_ID=BRL
ML_WARRANTY=Garantia do vendedor: 90 dias
# Quantidade usada quando o produto não tiver estoque informado no Tiny
ML_DEFAULT_QUANTITY=1

# ======================================================================
# Comportamento
# ======================================================================
REQUEST_TIMEOUT=30
RATE_LIMIT_SLEEP=0.4
STATE_FILE=sync_state.json
